entrypoint = "start.sh"
modules = ["python-3.12", "nodejs-20"]
hidden = [".venv", "node_modules", "frontend/dist", "golfreelz.db", "parone.db", "__pycache__"]

run = "bash start.sh"

[nix]
channel = "stable-24_05"

[env]
PYTHONUNBUFFERED = "1"
PIP_DISABLE_PIP_VERSION_CHECK = "1"
PIP_USER = "0"
PORT = "5000"

[deployment]
deploymentTarget = "cloudrun"
run = ["bash", "start.sh"]
build = ["bash", "build.sh"]

[[ports]]
localPort = 5000
externalPort = 80

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 bash start.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
