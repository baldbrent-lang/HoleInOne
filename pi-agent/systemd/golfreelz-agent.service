[Unit]
Description=GolfReelz Pi capture agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Match the user / paths used by install.sh — edit if you put the
# agent somewhere other than /opt/golfreelz-agent.
User=golfreelz
Group=golfreelz
WorkingDirectory=/opt/golfreelz-agent
# Creates /var/lib/golfreelz-agent owned by User=, before ExecStart, on
# every boot. That is work_dir: the in-flight recording and the upload
# spool live there. It has to outlive a reboot -- a clip part-way
# through a slow upload is exactly what the spool is for.
StateDirectory=golfreelz-agent
# libcamerify wraps the process with libcamera's V4L2 compat shim. The
# Raspberry Pi CSI cameras (IMX477 HQ cam, etc.) ONLY deliver processed
# RGB frames through this shim — opened raw via OpenCV they hand back
# all-black frames. (A plain USB/UVC webcam like a GoPro doesn't need it
# and passes straight through, so this is safe to leave on for both.)
ExecStart=/usr/bin/libcamerify /opt/golfreelz-agent/venv/bin/python3 /opt/golfreelz-agent/golfreelz_agent.py /opt/golfreelz-agent/config.yaml
Restart=on-failure
RestartSec=10
# Don't pin a memory limit — MediaPipe Pose can briefly use ~500 MB
# on a Pi 5 8 GB, well within bounds.
StandardOutput=journal
StandardError=journal
# If the backend rotates the camera's auth_token while we're running,
# we'll get 404s on the next call and crash — Restart=on-failure
# brings us back; on the next start the config still has the old
# token. Operator has to ssh in and update config.yaml.

[Install]
WantedBy=multi-user.target
