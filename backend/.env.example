DATABASE_URL=postgresql+psycopg://golfreelz:golfreelz@localhost:5432/golfreelz
APP_BASE_URL=http://localhost:5173
ADMIN_PASSWORD=Baldy123
# Optional. Leave EMPTY to use our own review page (/review/<token>),
# which is per-golfer and stores ratings in the reviews table. Set it to
# a Google/Trustpilot URL to send golfers there instead — that link is
# the same for everyone, so reviews stop being attributed to a round.
REVIEW_URL=
# Hours after the gallery email before the thank-you follows. 0 = off.
THANKS_DELAY_HOURS=4

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# SMTP (Gmail / Outlook / Yahoo / etc). Used in preference to SendGrid.
# Gmail: set SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<your-gmail>,
# SMTP_PASSWORD=<16-char App Password from myaccount.google.com/apppasswords>.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false

SHOT_TRACER_WEBHOOK_SECRET=
# What a confirmed hole-in-one pays, as it should read in the email
# and on the claim page. Empty falls back to "a prize".
HIO_PRIZE_LABEL=$10,000
# Contest prizes. Read back as "Your prize: <label>." Empty = "a prize".
CTP_PRIZE_LABEL=a free round on us, next time you play
SHOT_OF_WEEK_PRIZE_LABEL=a free round on us, plus your shot featured on our social media
MONTHLY_DRAW_PRIZE_LABEL=$100
